","state":"NSW","pair":"method_b vs method_c","correlation":0.835,"mean_abs_diff":0.603,"quarters_over_1ppt":23,"quarters":147,"key":"current|NSW|method_b vs method_c"},{"basis":"current","state":"NT","pair":"method_b vs method_c","correlation":0.554,"mean_abs_diff":2.032,"quarters_over_1ppt":92,"quarters":147,"key":"current|NT|method_b vs method_c"},{"basis":"current","state":"QLD","pair":"method_b vs method_c","correlation":0.714,"mean_abs_diff":1.193,"quarters_over_1ppt":60,"quarters":147,"key":"current|QLD|method_b vs method_c"},{"basis":"current","state":"SA","pair":"method_b vs method_c","correlation":0.825,"mean_abs_diff":0.555,"quarters_over_1ppt":19,"quarters":147,"key":"current|SA|method_b vs method_c"},{"basis":"current","state":"TAS","pair":"method_b vs method_c","correlation":0.574,"mean_abs_diff":1.153,"quarters_over_1ppt":63,"quarters":147,"key":"current|TAS|method_b vs method_c"},{"basis":"current","state":"VIC","pair":"method_b vs method_c","correlation":0.747,"mean_abs_diff":0.661,"quarters_over_1ppt":29,"quarters":147,"key":"current|VIC|method_b vs method_c"},{"basis":"current","state":"WA","pair":"method_b vs method_c","correlation":0.755,"mean_abs_diff":1.379,"quarters_over_1ppt":75,"quarters":147,"key":"current|WA|method_b vs method_c"},{"basis":"cvm","state":"ACT","pair":"method_b vs method_c","correlation":0.367,"mean_abs_diff":1.131,"quarters_over_1ppt":64,"quarters":147,"key":"cvm|ACT|method_b vs method_c"},{"basis":"cvm","state":"NSW","pair":"method_b vs method_c","correlation":0.875,"mean_abs_diff":0.503,"quarters_over_1ppt":15,"quarters":147,"key":"cvm|NSW|method_b vs method_c"},{"basis":"cvm","state":"NT","pair":"method_b vs method_c","correlation":0.444,"mean_abs_diff":1.647,"quarters_over_1ppt":85,"quarters":147,"key":"cvm|NT|method_b vs method_c"},{"basis":"cvm","state":"QLD","pair":"method_b vs method_c","correlation":0.78,"mean_abs_diff":0.662,"quarters_over_1ppt":32,"quarters":147,"key":"cvm|QLD|method_b vs method_c"},{"basis":"cvm","state":"SA","pair":"method_b vs method_c","correlation":0.759,"mean_abs_diff":0.523,"quarters_over_1ppt":19,"quarters":147,"key":"cvm|SA|method_b vs method_c"},{"basis":"cvm","state":"TAS","pair":"method_b vs method_c","correlation":0.526,"mean_abs_diff":0.966,"quarters_over_1ppt":49,"quarters":147,"key":"cvm|TAS|method_b vs method_c"},{"basis":"cvm","state":"VIC","pair":"method_b vs method_c","correlation":0.812,"mean_abs_diff":0.574,"quarters_over_1ppt":29,"quarters":147,"key":"cvm|VIC|method_b vs method_c"},{"basis":"cvm","state":"WA","pair":"method_b vs method_c","correlation":0.748,"mean_abs_diff":0.602,"quarters_over_1ppt":24,"quarters":147,"key":"cvm|WA|method_b vs method_c"}],"meta":[{"label":"07_dashboard_export.R","value":"# 07_dashboard_export.R ---------------------------------------------------------\n# Optional: writes the small JSON files behind the results dashboard\n# (output/dashboard/). Each file is {rows, meta}; meta carries this script.\n# Run after 06_validate.R.\n\nsource(\"R/utils.R\")\ndir.create(file.path(DIR_OUT, \"dashboard\"), showWarnings = FALSE)\nv <- read_proc(\"validation\")\nout <- readr::read_csv(file.path(DIR_OUT, \"quarterly_gsp.csv\"), show_col_types = FALSE)\nme <- paste(readLines(\"07_dashboard_export.R\"), collapse = \"\\n\")\nwrite_ds <- function(rows, name, input) {\n  meta <- list(list(label = \"07_dashboard_export.R\", value = me, type = \"code\", lang = \"r\"),\n               list(label = \"Input\", value = input),\n               list(label = \"ABS data to\", value = format(max(out$quarter), \"%B %Y\")))\n  jsonlite::write_json(list(rows = rows, meta = meta), file.path(DIR_OUT, \"dashboard\", paste0(name, \".json\")),\n                       auto_unbox = TRUE, digits = 6, na = \"null\")\n}\nmodels <- setdiff(unique(out$method), c(\"baseline_prorata\", \"baseline_denton\"))\n\ngsp <- out |> filter(method %in% models) |> group_by(state, price_basis, method) |> arrange(quarter, .by_group = TRUE) |>\n  mutate(growth = round(100 * (estimate / lag(estimate) - 1), 3)) |> ungroup() |>\n  transmute(key = paste(state, price_basis, method, quarter, sep = \"|\"), state, quarter = as.character(quarter),\n            basis = price_basis, method, estimate = round(estimate, 1), growth,\n            lower_90 = round(lower_90, 1), upper_90 = round(upper_90, 1), benchmarked)\nwrite_ds(gsp, \"gsp\", \"output/quarterly_gsp.csv\")\n\nrt <- v$rt_sum |> filter(method != \"method_a_prelim\") |>\n  transmute(key = paste(basis, method, state, sep = \"|\"), basis, method, state,\n            mae = round(mae, 3), rmse = round(rmse, 3), bias = round(bias, 3), max_abs = round(max_abs, 3))\nwrite_ds(rt, \"realtime\", \"output/validation_realtime_summary.csv\")\n\nqld <- v$qld$stats |> transmute(key = paste(basis, method, sep = \"|\"), basis, method, to = as.character(to), quarters = n,\n                                correlation = round(correlation, 3), mean_abs_diff = round(mean_abs_diff, 3),\n                                treasury_turning_points = qt_turning_points, matched_within_1q)\nwrite_ds(qld, \"qld\", \"output/validation_qld_treasury.csv\")\n\n# pairwise agreement of quarterly growth between the model-based methods\ng <- gsp |> select(state, basis, quarter, method, growth) |> filter(!is.na(growth))\npairs <- utils::combn(sort(models), 2, simplify = FALSE)\nagree <- purrr::map_dfr(pairs, function(p) {\n  inner_join(filter(g, method == p[1]), filter(g, method == p[2]), by = c(\"state\", \"basis\", \"quarter\")) |>\n    group_by(basis, state) |>\n    summarise(pair = paste(p, collapse = \" vs \"), correlation = round(cor(growth.x, growth.y), 3),\n              mean_abs_diff = round(mean(abs(growth.x - growth.y)), 3),\n              quarters_over_1ppt = sum(abs(growth.x - growth.y) > 1), quarters = n(), .groups = \"drop\")\n}) |> mutate(key = paste(basis, state, pair, sep = \"|\"))\nwrite_ds(agree, \"agreement\", \"output/quarterly_gsp.csv\")\nmsg(\"07_dashboard_export.R done:\", paste(list.files(file.path(DIR_OUT, \"dashboard\")), collapse = \", \"))","type":"code","lang":"r"},{"label":"Input","value":"output/quarterly_gsp.csv"},{"label":"ABS data to","value":"June 2026"}]}
